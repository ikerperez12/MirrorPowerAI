<Window x:Class="MirrorPowerAI.Windows.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:loc="clr-namespace:MirrorPowerAI.Windows.Resources"
        Title="{loc:Loc OverlayTitle}"
        Language="{Binding UiLanguage, Source={x:Static loc:LocalizationService.Current}, ConverterCulture=en-US}"
        automation:AutomationProperties.Name="{loc:Loc OverlayTitle}"
        Width="600"
        Height="360"
        MinWidth="400"
        MinHeight="240"
        AllowsTransparency="False"
        Background="{DynamicResource MirrorSurfaceBrush}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="16"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Border x:Name="StatusPanel"
                Padding="24"
                Background="{DynamicResource MirrorPanelBrush}"
                BorderBrush="{DynamicResource MirrorBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MirrorCardCornerRadius}"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level1"
                           Text="{loc:Loc OverlayTitle}" />
                <ProgressBar x:Name="StatusProgressBar"
                             Height="5"
                             Margin="0,16,0,18"
                             IsIndeterminate="True"
                             IsTabStop="False"
                             automation:AutomationProperties.Name="{loc:Loc OverlayProgressName}" />
                <TextBlock x:Name="StatusTextBlock"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <Button x:Name="StatusActionButton"
                        MinHeight="36"
                        Margin="0,16,0,0"
                        Padding="14,6"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        Click="OnStatusActionClick"
                        Content="{loc:Loc PauseListeningButton}"
                        automation:AutomationProperties.Name="{loc:Loc PauseListeningButton}"
                        automation:AutomationProperties.HelpText="{loc:Loc PauseListeningHelp}" />
            </StackPanel>
        </Border>

        <Border x:Name="ResultPanel"
                Padding="20"
                Background="{DynamicResource MirrorPanelBrush}"
                BorderBrush="{DynamicResource MirrorBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MirrorCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           FontSize="24"
                           FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level1"
                           Text="{loc:Loc OverlayTitle}" />

                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <Label x:Name="QuestionLabel"
                           Padding="0,0,0,4"
                           FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level2"
                           Target="{Binding ElementName=QuestionTextBox}"
                           Content="{loc:Loc QuestionHeading}" />
                    <TextBox x:Name="QuestionTextBox"
                             MinHeight="48"
                             MaxHeight="110"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             automation:AutomationProperties.LiveSetting="Polite"
                             automation:AutomationProperties.Name="{loc:Loc QuestionHeading}" />
                </StackPanel>

                <Label Grid.Row="2"
                       Padding="0,0,0,4"
                       FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level2"
                       Target="{Binding ElementName=AnswerTextBox}"
                       Content="{loc:Loc AnswerHeading}" />
                <TextBox x:Name="AnswerTextBox"
                         Grid.Row="3"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         automation:AutomationProperties.LiveSetting="Polite"
                         automation:AutomationProperties.Name="{loc:Loc AnswerHeading}" />

                <Button Grid.Row="4"
                        Margin="4,14,4,0"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Click="OnCloseClick"
                        Content="{loc:Loc CloseButton}" />
            </Grid>
        </Border>
    </Grid>
</Window>
